    "@paypal/agent-toolkit": "^1.11.0",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "overrides": {
    "mathjs": "^15.2.0",
    "@langchain/core": "^0.3.80",
    "langsmith": "^0.11.1",
    "jsondiffpatch": "^0.7.6",
